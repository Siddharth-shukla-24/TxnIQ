# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Builder
# Downloads and installs all Python dependencies in an isolated layer.
# This layer is cached by Docker — if requirements.txt doesn't change,
# Docker skips this step entirely on subsequent builds, saving minutes.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

# Set the working directory inside the builder container.
# All subsequent commands run from this directory.
WORKDIR /build

# Copy ONLY requirements.txt first (not the whole codebase).
# Why? Docker builds in layers. Each instruction creates a cached layer.
# If we copied all files first, any code change would invalidate the cache
# and force pip to reinstall everything from scratch — slow.
# By copying requirements.txt alone first, pip re-runs only when
# requirements.txt actually changes.
COPY requirements.txt .

# Upgrade pip first to avoid warnings about outdated pip during install.
# --no-cache-dir tells pip not to store downloaded packages locally inside
# the container — saves image size since we don't need them after install.
RUN pip install --upgrade pip --no-cache-dir \
    && pip install --no-cache-dir -r requirements.txt


# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Runtime
# The final image that actually runs. Starts fresh from the slim base,
# copies only what's needed from the builder. No build tools included.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# Don't write .pyc bytecode files to disk.
# In a container, there's no benefit to caching bytecode — the container
# is ephemeral. Skipping this reduces container size slightly.
ENV PYTHONDONTWRITEBYTECODE=1

# Don't buffer stdout/stderr.
# By default, Python buffers output and flushes it in chunks. In Docker,
# this means log messages appear delayed or not at all if the container
# crashes. Setting this to 1 flushes immediately — critical for debugging.
ENV PYTHONUNBUFFERED=1

# Create a non-root user for running the application.
# By default, Docker containers run as root — the most privileged user.
# If your app has a security vulnerability, the attacker gets root inside
# the container. Running as a non-root user limits the blast radius.
# This is a security best practice expected in production systems.
RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid appgroup --no-create-home appuser

# Set the working directory for the application.
WORKDIR /app

# Copy installed Python packages from the builder stage.
# /usr/local/lib/python3.11/site-packages is where pip installs packages.
# We copy the entire directory from builder to runtime.
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Copy installed executables (uvicorn, celery CLI, alembic CLI).
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy the application source code.
# This layer changes often (every code edit), so it comes last.
# Layers that change often go at the bottom to maximize cache utilization.
COPY ./app ./app
COPY ./alembic ./alembic
COPY ./alembic.ini ./alembic.ini


COPY ./scripts/start.sh ./scripts/start.sh
RUN chmod +x ./scripts/start.sh


# Create the uploads directory with correct ownership.
# The appuser needs write permission here to save uploaded CSVs.
RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app

# Switch to the non-root user for all subsequent commands.
# This USER instruction affects both RUN commands below AND the final++
# CMD — the app itself runs as appuser.
USER appuser

# Document that this container listens on port 8000.
# EXPOSE is documentation only — it doesn't actually open the port.
# Docker Compose opens the port via its `ports` configuration.
EXPOSE 8000

# The command that starts when this container runs.
# Breaking it down:
#   uvicorn          → the ASGI server
#   app.main:app     → import `app` object from `app/main.py`
#   --host 0.0.0.0   → listen on all network interfaces (not just localhost)
#                      Without this, the API is unreachable from outside the container
#   --port 8000      → listen on port 8000
#   --workers 1      → number of worker processes (1 for simplicity; scale up in prod)
CMD ["./scripts/start.sh"]
